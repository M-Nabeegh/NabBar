{
  "sdk": 6,
  "version": 2,
  "name": "NabBar",
  "id": "com.nabeegh.nabbar.touchportal",
  "configuration": {
    "colorDark": "#1E2125",
    "colorLight": "#4FE3A6"
  },
  "plugin_start_cmd_mac": "/usr/bin/python3 \"%TP_PLUGIN_FOLDER%NabBar/plugin.py\"",
  "plugin_start_cmd": "/usr/bin/python3 \"%TP_PLUGIN_FOLDER%NabBar/plugin.py\"",
  "categories": [
    {
      "id": "com.nabeegh.nabbar.touchportal.cat",
      "name": "NabBar",
      "actions": [
        {
          "id": "com.nabeegh.nabbar.touchportal.action.refresh",
          "name": "Refresh NabBar",
          "prefix": "NabBar",
          "type": "communicate",
          "tryInline": true,
          "format": "Refresh NabBar now"
        }
      ],
      "events": [
        {
          "id": "com.nabeegh.nabbar.touchportal.event.codex.level",
          "name": "NabBar: Codex level",
          "format": "When Codex level becomes $val",
          "type": "communicate",
          "valueType": "choice",
          "valueChoices": [
            "green",
            "yellow",
            "red",
            "depleted"
          ],
          "valueStateId": "com.nabeegh.nabbar.touchportal.state.codex.level"
        },
        {
          "id": "com.nabeegh.nabbar.touchportal.event.claude.level",
          "name": "NabBar: Claude level",
          "format": "When Claude level becomes $val",
          "type": "communicate",
          "valueType": "choice",
          "valueChoices": [
            "green",
            "yellow",
            "red",
            "depleted"
          ],
          "valueStateId": "com.nabeegh.nabbar.touchportal.state.claude.level"
        },
        {
          "id": "com.nabeegh.nabbar.touchportal.event.commandcode.level",
          "name": "NabBar: Command Code level",
          "format": "When Command Code level becomes $val",
          "type": "communicate",
          "valueType": "choice",
          "valueChoices": [
            "green",
            "yellow",
            "red",
            "depleted"
          ],
          "valueStateId": "com.nabeegh.nabbar.touchportal.state.commandcode.level"
        }
      ],
      "states": [
        {
          "id": "com.nabeegh.nabbar.touchportal.state.codex.left",
          "type": "text",
          "desc": "NabBar: Codex % left",
          "default": "--"
        },
        {
          "id": "com.nabeegh.nabbar.touchportal.state.codex.used",
          "type": "text",
          "desc": "NabBar: Codex % used",
          "default": "--"
        },
        {
          "id": "com.nabeegh.nabbar.touchportal.state.codex.reset",
          "type": "text",
          "desc": "NabBar: Codex reset time",
          "default": ""
        },
        {
          "id": "com.nabeegh.nabbar.touchportal.state.codex.status",
          "type": "text",
          "desc": "NabBar: Codex status",
          "default": ""
        },
        {
          "id": "com.nabeegh.nabbar.touchportal.state.codex.summary",
          "type": "text",
          "desc": "NabBar: Codex summary (name + % left)",
          "default": ""
        },
        {
          "id": "com.nabeegh.nabbar.touchportal.state.codex.level",
          "type": "text",
          "desc": "NabBar: Codex level (green / yellow / red / depleted)",
          "default": "unknown"
        },
        {
          "id": "com.nabeegh.nabbar.touchportal.state.codex.icon",
          "type": "text",
          "desc": "NabBar: Codex meter icon (use with Change icon from plugin state)",
          "default": ""
        },
        {
          "id": "com.nabeegh.nabbar.touchportal.state.claude.left",
          "type": "text",
          "desc": "NabBar: Claude % left",
          "default": "--"
        },
        {
          "id": "com.nabeegh.nabbar.touchportal.state.claude.used",
          "type": "text",
          "desc": "NabBar: Claude % used",
          "default": "--"
        },
        {
          "id": "com.nabeegh.nabbar.touchportal.state.claude.reset",
          "type": "text",
          "desc": "NabBar: Claude reset time",
          "default": ""
        },
        {
          "id": "com.nabeegh.nabbar.touchportal.state.claude.status",
          "type": "text",
          "desc": "NabBar: Claude status",
          "default": ""
        },
        {
          "id": "com.nabeegh.nabbar.touchportal.state.claude.summary",
          "type": "text",
          "desc": "NabBar: Claude summary (name + % left)",
          "default": ""
        },
        {
          "id": "com.nabeegh.nabbar.touchportal.state.claude.level",
          "type": "text",
          "desc": "NabBar: Claude level (green / yellow / red / depleted)",
          "default": "unknown"
        },
        {
          "id": "com.nabeegh.nabbar.touchportal.state.claude.icon",
          "type": "text",
          "desc": "NabBar: Claude meter icon (use with Change icon from plugin state)",
          "default": ""
        },
        {
          "id": "com.nabeegh.nabbar.touchportal.state.commandcode.left",
          "type": "text",
          "desc": "NabBar: Command Code % left",
          "default": "--"
        },
        {
          "id": "com.nabeegh.nabbar.touchportal.state.commandcode.used",
          "type": "text",
          "desc": "NabBar: Command Code % used",
          "default": "--"
        },
        {
          "id": "com.nabeegh.nabbar.touchportal.state.commandcode.reset",
          "type": "text",
          "desc": "NabBar: Command Code reset time",
          "default": ""
        },
        {
          "id": "com.nabeegh.nabbar.touchportal.state.commandcode.status",
          "type": "text",
          "desc": "NabBar: Command Code status",
          "default": ""
        },
        {
          "id": "com.nabeegh.nabbar.touchportal.state.commandcode.summary",
          "type": "text",
          "desc": "NabBar: Command Code summary (name + % left)",
          "default": ""
        },
        {
          "id": "com.nabeegh.nabbar.touchportal.state.commandcode.level",
          "type": "text",
          "desc": "NabBar: Command Code level (green / yellow / red / depleted)",
          "default": "unknown"
        },
        {
          "id": "com.nabeegh.nabbar.touchportal.state.commandcode.icon",
          "type": "text",
          "desc": "NabBar: Command Code meter icon (use with Change icon from plugin state)",
          "default": ""
        },
        {
          "id": "com.nabeegh.nabbar.touchportal.state.updatedAt",
          "type": "text",
          "desc": "NabBar: last updated",
          "default": ""
        }
      ]
    }
  ]
}